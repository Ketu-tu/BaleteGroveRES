<style>
    .modal {
        display: none;
        position: fixed;
        z-index: 10000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(45, 82, 52, 0.5);
        backdrop-filter: blur(4px);
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

    .modal-content {
        background: #f4f5f0;
        padding: 30px 25px;
        border-radius: 20px;
        width: 100%;
        max-width: 500px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.2);
        display: flex;
        flex-direction: column;
        gap: 20px;
        position: relative;
    }

        .modal-content h2 {
            margin: 0;
            color: #234e33;
            font-weight: 700;
        }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

        .form-group label {
            font-weight: 600;
            color: #234e33;
            font-size: 14px;
        }

    .modal-content input,
    .modal-content textarea {
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #ccc;
        width: 100%;
        font-size: 14px;
        font-family: inherit;
    }

    .button-group {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        margin-top: 10px;
    }

    .modal-content button {
        padding: 10px 20px;
        border-radius: 12px;
        border: none;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s ease;
    }

        .modal-content button:hover {
            opacity: 0.9;
        }

    
    .modal-content .add,
    .modal-content .save {
        background: #366642;
        color: white;
    }

    .modal-content .delete {
        background: #b83232;
        color: white;
    }

    .modal-content .cancel {
        background: #999;
        color: white;
    }

    .close-modal {
        position: absolute;
        right: 20px;
        top: 20px;
        font-size: 24px;
        cursor: pointer;
        color: #234e33;
        line-height: 1;
    }
</style>

<div id="addFaqModal" class="modal">
    <div class="modal-content">
        <span class="close-modal" onclick="closeModal('addFaqModal')">&times;</span>
        <h2>Add FAQ</h2>
        <form asp-action="CreateFAQ" asp-controller="Admin" method="post">
            <div class="form-group">
                <label>Question</label>
                <input type="text" name="Question" id="addQuestion" placeholder="Enter question" required />
            </div>
            <div class="form-group">
                <label>Answer</label>
                <textarea name="Answer" id="addAnswer" placeholder="Enter answer" required rows="4"></textarea>
            </div>
            <div class="button-group">
                <button type="submit" class="add">Add FAQ</button>
                <button type="button" class="cancel" onclick="closeModal('addFaqModal')">Cancel</button>
            </div>
        </form>
    </div>
</div>

<div id="editFaqModal" class="modal">
    <div class="modal-content">
        <span class="close-modal" onclick="closeModal('editFaqModal')">&times;</span>
        <h2>Edit FAQ</h2>
        <form asp-action="EditFAQ" asp-controller="Admin" method="post">
            <input type="hidden" name="Id" id="editFaqId" />
            <div class="form-group">
                <label>Question</label>
                <input type="text" name="Question" id="editQuestion" required />
            </div>
            <div class="form-group">
                <label>Answer</label>
                <textarea name="Answer" id="editAnswer" required rows="4"></textarea>
            </div>
            <div class="button-group">
                <button type="submit" class="save">Save Changes</button>
                <button type="button" class="cancel" onclick="closeModal('editFaqModal')">Cancel</button>
            </div>
        </form>
    </div>
</div>

<div id="deleteFaqModal" class="modal">
    <div class="modal-content">
        <span class="close-modal" onclick="closeModal('deleteFaqModal')">&times;</span>
        <h2>Confirm Delete</h2>
        <form asp-action="DeleteFAQ" asp-controller="Admin" method="post">
            <input type="hidden" name="Id" id="deleteFaqId" />
            <p style="color: #444; margin: 0;">Are you sure you want to delete this FAQ?</p>
            <div class="button-group">
                <button type="submit" class="delete">Delete</button>
                <button type="button" class="cancel" onclick="closeModal('deleteFaqModal')">Cancel</button>
            </div>
        </form>
    </div>
</div>