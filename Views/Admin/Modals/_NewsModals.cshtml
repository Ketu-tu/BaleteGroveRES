<style>
    
    .modal {
        display: none;
        position: fixed;
        z-index: 10000; 
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(45, 82, 52, 0.5); 
        backdrop-filter: blur(4px); 
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

    
    .modal-content {
        background: #f4f5f0;
        padding: 30px 25px;
        border-radius: 20px;
        width: 100%;
        max-width: 500px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.2);
        display: flex;
        flex-direction: column;
        gap: 20px;
        position: relative;
    }

        .modal-content h2 {
            margin: 0;
            color: #234e33;
            font-weight: 700;
        }

        .modal-content .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
            margin-bottom: 15px;
        }

            .modal-content .form-group label {
                font-weight: 600;
                color: #234e33;
                font-size: 14px;
            }

        .modal-content input[type="file"],
        .modal-content input[type="text"],
        .modal-content textarea {
            padding: 10px;
            border-radius: 8px;
            border: 1px solid #ccc;
            width: 100%;
            font-size: 14px;
            box-sizing: border-box;
        }

    .button-group {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        margin-top: 10px;
    }

    .modal-content button {
        padding: 10px 20px;
        border-radius: 12px;
        border: none;
        font-weight: 600;
        cursor: pointer;
        transition: 0.25s;
    }

    .button-group .add, .button-group .save {
        background: #366642;
        color: white;
    }

    .button-group .delete {
        background: #b83232;
        color: white;
    }

    .button-group .cancel {
        background: #999;
        color: white;
    }

    .close-modal {
        position: absolute;
        right: 20px;
        top: 20px;
        font-size: 24px;
        cursor: pointer;
        color: #234e33;
    }
</style>

<div id="addNewsModal" class="modal">
    <div class="modal-content">
        <span class="close-modal" onclick="closeModal('addNewsModal')">&times;</span>
        <h2>Add News</h2>
        <form asp-action="Create" asp-controller="Admin" method="post" enctype="multipart/form-data">
            <div class="form-group">
                <label>Image</label>
                <input type="file" name="imageFile" required />
            </div>
            <div class="form-group">
                <label>Headline</label>
                <input type="text" name="Headline" placeholder="Enter headline" required />
            </div>
            <div class="form-group">
                <label>Information</label>
                <textarea name="Information" placeholder="Enter information" required></textarea>
            </div>
            <div class="button-group">
                <button type="submit" class="add">Add News</button>
                <button type="button" class="cancel" onclick="closeModal('addNewsModal')">Cancel</button>
            </div>
        </form>
    </div>
</div>

<div id="editNewsModal" class="modal">
    <div class="modal-content">
        <span class="close-modal" onclick="closeModal('editNewsModal')">&times;</span>
        <h2>Edit News</h2>
        <form asp-action="Edit" asp-controller="Admin" method="post" enctype="multipart/form-data">
            <input type="hidden" name="Id" id="editNewsId" />
            <div class="form-group">
                <label>Image (Optional)</label>
                <input type="file" name="imageFile" accept="image/*" />
            </div>
            <div class="form-group">
                <label>Headline</label>
                <input type="text" name="Headline" id="editHeadline" required />
            </div>
            <div class="form-group">
                <label>Information</label>
                <textarea name="Information" id="editInformation" required></textarea>
            </div>
            <div class="button-group">
                <button type="submit" class="save">Save Changes</button>
                <button type="button" class="cancel" onclick="closeModal('editNewsModal')">Cancel</button>
            </div>
        </form>
    </div>
</div>

<div id="deleteNewsModal" class="modal">
    <div class="modal-content">
        <span class="close-modal" onclick="closeModal('deleteNewsModal')">&times;</span>
        <h2>Confirm Delete</h2>
        <form asp-action="Delete" asp-controller="Admin" method="post">
            <input type="hidden" name="Id" id="deleteNewsId" />
            <p>Are you sure you want to delete this news item? This action cannot be undone.</p>
            <div class="button-group">
                <button type="submit" class="delete">Delete</button>
                <button type="button" class="cancel" onclick="closeModal('deleteNewsModal')">Cancel</button>
            </div>
        </form>
    </div>
</div>