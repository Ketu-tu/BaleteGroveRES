<style>
    .modal {
        display: none;
        position: fixed;
        z-index: 10000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(45, 82, 52, 0.5);
        backdrop-filter: blur(4px);
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

    .modal-content {
        background: #f4f5f0;
        padding: 30px 25px;
        border-radius: 20px;
        width: 100%;
        max-width: 500px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.2);
        display: flex;
        flex-direction: column;
        gap: 20px;
        position: relative;
        font-family: 'Montserrat', sans-serif;
    }

        .modal-content h2 {
            margin: 0;
            color: #234e33;
            font-weight: 700;
        }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

        .form-group label {
            font-weight: 600;
            color: #234e33;
            font-size: 14px;
            margin-bottom: 1px; 
            margin-top: 8px;
        }

    .modal-content input,
    .modal-content select {
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #ccc;
        width: 100%;
        font-size: 14px;
    }

    
    .input-eye-wrapper {
        position: relative;
        display: flex;
        width: 100%;
        
        padding: 0;
    }

        .input-eye-wrapper input {
            width: 100%;
            
            padding-right: 35px !important;
            box-sizing: border-box;
        }

    .btn-eye {
        position: absolute;
        
        
        right: 8px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        padding: 0;
        margin: 0;
        cursor: pointer;
        color: #666;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
    }


    .button-group {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        margin-top: 15px; 
    }

    .modal-content button {
        padding: 10px 20px;
        border-radius: 12px;
        border: none;
        font-weight: 600;
        cursor: pointer;
    }

    .modal-content p {
        margin-bottom: 15px;
        line-height: 1.5;
    }

    .add, .save {
        background: #366642;
        color: white;
    }

    .delete {
        background: #b83232;
        color: white;
    }

    .warning {
        background: #c47f00;
        color: white;
    }

    .cancel {
        background: #999;
        color: white;
    }

    .close-modal {
        position: absolute;
        right: 20px;
        top: 20px;
        font-size: 24px;
        cursor: pointer;
        color: #234e33;
    }
</style>


<div id="addUserModal" class="modal">
    <div class="modal-content">
        <span class="close-modal" onclick="closeModal('addUserModal')">&times;</span>
        <h2>Add User</h2>

        <form asp-controller="Admin" asp-action="CreateUser" method="post">
            <div class="form-group">
                <label>Full Name</label>
                <input type="text" name="FullName" id="addFullName" placeholder="Enter full name" required />
            </div>

            <div class="form-group">
                <label>Email</label>
                <input type="email" name="Email" id="addEmail" placeholder="Enter email" pattern="^[a-zA-Z0-9._%+\-]+&#64;[a-zA-Z0-9.\-]+\.[a-zA-Z]{2,}$" title="Please enter a valid email address (e.g., name@example.com)" required />
            </div>

            <div class="form-group">
                <label>Password</label>
                <div class="input-eye-wrapper">
                    <input type="password" name="Password" id="addPassword" placeholder="Enter password" pattern="(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).{6,}" title="Password must be at least 6 characters long, contain at least one uppercase letter, one number, and one symbol." required />
                    <button type="button" class="btn-eye" onclick="togglePassword('addPassword', this)">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
            </div>

            <div class="form-group">
                <label>Role</label>
                <select name="Role" id="addRole" required>
                    <option value="" disabled selected>Select role</option>
                    <option value="SuperAdmin">Super Admin</option>
                    <option value="Admin">Admin</option>
                    <option value="Agent">Agent</option>
                </select>
            </div>

            <div class="button-group">
                <button type="submit" class="add">Create</button>
                <button type="button" class="cancel" onclick="closeModal('addUserModal')">Cancel</button>
            </div>
        </form>
    </div>
</div>


<div id="editUserModal" class="modal">
    <div class="modal-content">
        <span class="close-modal" onclick="closeModal('editUserModal')">&times;</span>
        <h2>Edit User</h2>

        <form asp-controller="Admin" asp-action="EditUser" method="post">
            <input type="hidden" name="UserId" id="editUserId" />

            <div class="form-group">
                <label>Full Name</label>
                <input type="text" name="FullName" id="editFullName" required />
            </div>

            <div class="form-group">
                <label>Email</label>
                <input type="email" name="Email" id="editEmail" pattern="^[a-zA-Z0-9._%+\-]+&#64;[a-zA-Z0-9.\-]+\.[a-zA-Z]{2,}$" title="Please enter a valid email address (e.g., name@example.com)" required />
            </div>

            <div class="form-group">
                <label>Role</label>
                <select name="Role" id="editRole" required>
                    <option value="SuperAdmin">Super Admin</option>
                    <option value="Admin">Admin</option>
                    <option value="Agent">Agent</option>
                </select>
            </div>

            <div class="button-group">
                <button type="submit" class="save">Save Changes</button>
                <button type="button" class="cancel" onclick="closeModal('editUserModal')">Cancel</button>
            </div>
        </form>
    </div>
</div>


<div id="resetPasswordModal" class="modal">
    <div class="modal-content">
        <span class="close-modal" onclick="closeModal('resetPasswordModal')">&times;</span>
        <h2>Reset Password</h2>

        <form asp-controller="Admin" asp-action="ResetUserPassword" method="post">
            <input type="hidden" name="UserId" id="resetUserId" />

            <p>Enter a new password for <strong id="resetUserName"></strong>.</p>

            <div class="form-group">
                <label>New Password</label>
                <div class="input-eye-wrapper">
                    <input type="password" name="NewPassword" id="resetNewPassword" pattern="(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).{6,}" title="Password must be at least 6 characters long, contain at least one uppercase letter, one number, and one symbol." required />
                    <button type="button" class="btn-eye" onclick="togglePassword('resetNewPassword', this)">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
            </div>

            <div class="form-group">
                <label>Your Admin Password (to confirm)</label>
                <div class="input-eye-wrapper">
                    <input type="password" name="AdminPassword" id="resetAdminPassword" placeholder="Confirm your identity" required />
                    <button type="button" class="btn-eye" onclick="togglePassword('resetAdminPassword', this)">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
            </div>

            <div class="button-group">
                <button type="submit" class="warning">Reset</button>
                <button type="button" class="cancel" onclick="closeModal('resetPasswordModal')">Cancel</button>
            </div>
        </form>
    </div>
</div>


<div id="deleteUserModal" class="modal">
    <div class="modal-content">
        <span class="close-modal" onclick="closeModal('deleteUserModal')">&times;</span>
        <h2 id="deleteModalTitle">Deactivate User</h2>

        <form asp-controller="Admin" asp-action="DeactivateUser" method="post">
            <input type="hidden" name="UserId" id="deleteUserId" />

            <p>Are you sure you want to <span id="deleteModalActionText">deactivate</span> <strong id="deleteUserName"></strong>?</p>

            <div class="button-group">
                <button type="submit" class="delete" id="deleteSubmitBtn">Deactivate</button>
                <button type="button" class="cancel" onclick="closeModal('deleteUserModal')">Cancel</button>
            </div>
        </form>
    </div>
</div>