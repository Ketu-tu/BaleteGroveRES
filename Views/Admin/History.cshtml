@model IEnumerable<BaleteGroveRES.Models.Admin.SystemLog>
@{
    ViewData["Title"] = "System History";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    string searchQuery = ViewBag.SearchQuery ?? "";
    bool isSearching = ViewBag.IsSearching ?? false;
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="~/css/admin-usermanagement.css" asp-append-version="true">

<partial name="_AdminSideBar" />

<div class="dashboard-container">
    <style>
        .user-hover-container {
            position: relative;
            display: inline-block;
            cursor: pointer;
        }

        .user-tooltip {
            visibility: hidden;
            opacity: 0;
            width: max-content;
            background-color: white;
            color: #2e4633;
            text-align: center;
            border-radius: 12px;
            padding: 15px;
            position: absolute;
            z-index: 9999;
            top: 50%;
            left: 100%;
            margin-left: 15px;
            transform: translateY(-50%);
            box-shadow: 0 4px 16px rgba(0,0,0,0.15);
            transition: opacity 0.3s;
            border: 1px solid #e1e1e1;
        }

        .user-tooltip::after {
            content: "";
            position: absolute;
            top: 50%;
            right: 100%; 
            margin-top: -5px;
            border-width: 5px;
            border-style: solid;
            border-color: transparent white transparent transparent;
        }

        .user-hover-container:hover .user-tooltip {
            visibility: visible;
            opacity: 1;
        }
        
        .tooltip-img {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #366642;
            margin-bottom: 8px;
        }
    </style>
    <div class="dashboard-inner">
        <h1>System History Logs</h1>

        <div class="table-header">
            <div class="left-controls">
                <input type="text" placeholder="Search logs..." id="logSearch"
                       value="@searchQuery"
                       onkeyup="if(event.key==='Enter') submitSearch()" />

                
@{
    string s5  = pageSize == 5  ? "selected" : "";
    string s10 = pageSize == 10 ? "selected" : "";
    string s25 = pageSize == 25 ? "selected" : "";
    string s50 = pageSize == 50 ? "selected" : "";
}

<select id="userEntriesSelect" onchange="changePageSize(this.value)">
    <option value="5"  selected="@(pageSize == 5)">Show 5</option>
    <option value="10" selected="@(pageSize == 10)">Show 10</option>
    <option value="25" selected="@(pageSize == 25)">Show 25</option>
    <option value="50" selected="@(pageSize == 50)">Show 50</option>
</select>

                <div class="entry-counter" id="logCounter">@ViewBag.TotalItems entries</div>
            </div>
        </div>

        <div class="table-wrapper">
            <table id="logTable">
                <thead>
                    <tr>
                        <th>Date & Time</th>
                        <th>User</th>
                        <th>Module</th>
                        <th>Action</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        var avatars = ViewBag.UserAvatars as Dictionary<string, string>;
                        string avatarUrl = (avatars != null && avatars.ContainsKey(log.UserId) && !string.IsNullOrEmpty(avatars[log.UserId])) 
                            ? avatars[log.UserId] 
                            : "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(log.Email) + "&background=e8ecd7&color=1F5633";

                        <tr class="log-row">
                            <td>
                                <strong>@log.Timestamp.ToString("MMM dd, yyyy")</strong><br />
                                <span style="font-size:0.85em; color:#555;">@log.Timestamp.ToString("hh:mm tt")</span>
                            </td>
                            <td>
                                @{
                                    var userNames = ViewBag.UserNames as Dictionary<string, string>;
                                    string fullName = (userNames != null && userNames.ContainsKey(log.UserId) && !string.IsNullOrWhiteSpace(userNames[log.UserId]))
                                        ? userNames[log.UserId]
                                        : "N/A";

                                    var userPhones = ViewBag.UserPhones as Dictionary<string, string>;
                                    string phone = (userPhones != null && userPhones.ContainsKey(log.UserId) && !string.IsNullOrWhiteSpace(userPhones[log.UserId])) ? userPhones[log.UserId] : "—";

                                    var userDOBs = ViewBag.UserDOBs as Dictionary<string, DateTime?>;
                                    string dob = (userDOBs != null && userDOBs.ContainsKey(log.UserId) && userDOBs[log.UserId].HasValue) ? userDOBs[log.UserId].Value.ToString("MMM dd, yyyy") : "—";

                                    var userLeaveStatus = ViewBag.UserLeaveStatus as Dictionary<string, bool>;
                                    bool isOnLeave = (userLeaveStatus != null && userLeaveStatus.ContainsKey(log.UserId)) ? userLeaveStatus[log.UserId] : false;

                                    var userLockouts = ViewBag.UserLockouts as Dictionary<string, bool>;
                                    bool isLocked = (userLockouts != null && userLockouts.ContainsKey(log.UserId)) ? userLockouts[log.UserId] : false;
                                }
                                <div class="user-hover-container">
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <img src="@avatarUrl" alt="Avatar" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1px solid #ddd;" />
                                        <span>@log.Email</span>
                                    </div>
                                    <div class="user-tooltip">
                                        <img src="@avatarUrl" alt="Avatar" class="tooltip-img" />
                                        <div style="font-weight: 700; font-size: 16px; margin-bottom: 5px;">@fullName</div>
                                        <div style="font-size: 12px; color: #666; margin-bottom: 10px;">@log.Email</div>
                                        
                                        <div style="display: flex; flex-direction: column; gap: 5px; text-align: left; background: #f8f9fa; padding: 10px; border-radius: 8px;">
                                            <div style="font-size: 12px;"><strong>Phone:</strong> @phone</div>
                                            <div style="font-size: 12px;"><strong>DOB:</strong> @dob</div>
                                        </div>

                                        <div style="display: flex; justify-content: center; gap: 8px; margin-top: 12px;">
                                            @if(isLocked) {
                                                <span style="background: #ffe6e6; color: #d32f2f; padding: 3px 8px; border-radius: 12px; font-size: 11px; font-weight: 600;">Locked Out</span>
                                            } else {
                                                <span style="background: #e2f0e5; color: #1F5633; padding: 3px 8px; border-radius: 12px; font-size: 11px; font-weight: 600;">Active Account</span>
                                            }

                                            @if(isOnLeave) {
                                                <span style="background: #fff3cd; color: #856404; padding: 3px 8px; border-radius: 12px; font-size: 11px; font-weight: 600;">On Leave</span>
                                            } else {
                                                <span style="background: #e2f0e5; color: #1F5633; padding: 3px 8px; border-radius: 12px; font-size: 11px; font-weight: 600;">Working</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="role-badge" style="background:#e8ecd7; color:#1F5633;">@log.Module</span></td>
                            <td><span class="status-badge" style="background:#2C3729; color:white;">@log.Action</span></td>
                            <td>@log.Details</td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" style="text-align:center; padding:20px;">No system logs found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!isSearching)
        {
            <div class="pagination-controls">
                <a href="?page=1&pageSize=@pageSize" class="btn-page @(currentPage <= 1 ? "disabled" : "")">First</a>
                <a href="?page=@(currentPage - 1)&pageSize=@pageSize" class="btn-page @(currentPage <= 1 ? "disabled" : "")">Prev</a>
                <span id="userPageInfo">Page @currentPage of @totalPages</span>
                <a href="?page=@(currentPage + 1)&pageSize=@pageSize" class="btn-page @(currentPage >= totalPages ? "disabled" : "")">Next</a>
                <a href="?page=@totalPages&pageSize=@pageSize" class="btn-page @(currentPage >= totalPages ? "disabled" : "")">Last</a>
            </div>
        }
    </div>
</div>

<script>
    function submitSearch() {
        const query = document.getElementById("logSearch").value;
        const size = document.getElementById("userEntriesSelect").value;
        window.location.href = `?page=1&pageSize=${size}&search=${encodeURIComponent(query)}`;
    }

    function changePageSize(size) {
        const query = document.getElementById("logSearch").value;
        if (query) {
            window.location.href = `?page=1&pageSize=${size}&search=${encodeURIComponent(query)}`;
        } else {
            window.location.href = `?page=1&pageSize=${size}`;
        }
    }
</script>