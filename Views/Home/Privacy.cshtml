@{
    ViewData["Title"] = "Privacy Policy";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home-privacy.css" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
}

<partial name="_NavBar" />

<section class="privacy-container">
    <div class="privacy-header">
        <h1>Privacy Policy</h1>
        <p>
            This Privacy Policy describes how Balete Grove Real Estate ("we", "our", or "us") handles your information.
            Please note that this website and its contents were created solely for an academic project and do not represent a real estate company.
        </p>
    </div>

    <div class="divider-line"></div>

    <div class="privacy-section">
        <h2>1. Purpose of This Website</h2>
        <p>
            This website is part of a school project designed to demonstrate web development, UI/UX design, and software engineering principles.
            No real commercial transactions, personal data collection, or marketing activities are performed through this site.
        </p>
    </div>

    <div class="privacy-section">
        <h2>2. Information We Collect</h2>
        <p>
            For demonstration purposes, this site may include sample input forms or mock login systems.
            Any data entered on these pages is not stored, shared, or processed beyond this project’s local or academic environment.
        </p>
        <ul>
            <li>Sample contact forms may collect temporary names or emails for testing only.</li>
            <li>No financial or sensitive information is requested or stored.</li>
            <li>All data is automatically cleared after testing sessions.</li>
        </ul>
    </div>

    <div class="privacy-section">
        <h2>3. Use of Cookies</h2>
        <p>
            This project may use basic cookies or local storage to simulate real-world website behavior.
            These are only used to enhance user experience during demonstrations and contain no personally identifiable information.
        </p>
    </div>

    <div class="privacy-section">
        <h2>4. Third-Party Content & Stock Images</h2>
        <p>
            Some media and illustrations used in this site are sourced from royalty-free stock image platforms such as:
        </p>
        <ul>
            <li>Pexels (<a href="https://www.pexels.com" target="_blank">pexels.com</a>)</li>
            <li>Unsplash (<a href="https://www.unsplash.com" target="_blank">unsplash.com</a>)</li>
            <li>Freepik (<a href="https://www.freepik.com" target="_blank">freepik.com</a>)</li>
        </ul>
        <p>
            All images are used strictly for educational and non-commercial purposes, with full respect for creator licenses.
        </p>
    </div>

    <div class="privacy-section">
        <h2>5. Data Security</h2>
        <p>
            Since this site is only a student project, there are no real servers or databases connected to it. Any sample authentication or registration features are purely demonstrative.
            No actual personal data is collected, stored, or transmitted to third parties.
        </p>
    </div>

    <div class="privacy-section">
        <h2>6. Academic Use Disclaimer</h2>
        <p>
            This project was developed for educational purposes under the guidance of our school’s academic requirements.
            All names, logos, and property descriptions are fictional and do not represent real entities.
        </p>
    </div>

    <div class="privacy-section">
        <h2>7. Contact Information</h2>
        <p>
            For any questions regarding this project, its contents, or this privacy policy, please contact the project group through:
        </p>
        <p><strong>Email:</strong> BGREC@gmail.com</p>
        <p><strong>Phone:</strong> (09) 1234-5678</p>
    </div>

    <div class="privacy-footer">
        <p>© 2025 Balete Grove Real Estate — Educational Project Only</p>
        <p>All Rights Reserved</p>
    </div>
</section>

<partial name="_Footer" />